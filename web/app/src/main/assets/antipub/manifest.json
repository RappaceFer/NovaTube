{
  "manifest_version": 3,
  "name": "NovaTube anti-pub",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "antipub@novatube.rappace" } },
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["antipub.js"],
    "run_at": "document_start",
    "all_frames": true,
    "world": "MAIN"
  }]
}
